{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmarks.getbible.net/schema/api/chapter.schema.json",
  "title": "v1/verses/<book>/<chapter>.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book",
    "chapter",
    "verses"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "book": {
      "type": "integer",
      "minimum": 1,
      "maximum": 66
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 150
    },
    "verses": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]{0,3}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        }
      }
    }
  }
}
