{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmarks.getbible.net/schema/links.schema.json",
  "title": "Verse links for one topic (data/links/<topic>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topic",
    "verses"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "verses": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 66
          },
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 150
          },
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        ],
        "items": false,
        "description": "Translation-independent [book, chapter, verse] in the 66-book Protestant canon."
      }
    }
  }
}
