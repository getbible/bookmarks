# /etc/getbible-bookmarks/env — environment for the management API and the sync timer.
# Keep this file root-owned, readable by the service user only (mode 0640, group getbible-bookmarks).

# Checkout the service commits to. Must be on BOOKMARKS_GIT_BRANCH with a clean tree.
BOOKMARKS_REPO_DIR=/srv/getbible-bookmarks/repo

# Contributor registry written by `getbible-bookmarks tokens ...` (mode 0600, service user).
BOOKMARKS_CONTRIBUTORS_FILE=/etc/getbible-bookmarks/contributors.json

# Release root served by nginx: <dir>/current -> <dir>/releases/<checksum>.
BOOKMARKS_RELEASE_DIR=/srv/getbible-bookmarks/www

# Loopback listener nginx proxies /v1/manage/ to.
BOOKMARKS_BIND=127.0.0.1
BOOKMARKS_PORT=8787
BOOKMARKS_API_PREFIX=/v1/manage

# Git publication. Leave BOOKMARKS_GIT_REMOTE empty to commit locally without fetch/push.
BOOKMARKS_GIT_REMOTE=origin
BOOKMARKS_GIT_BRANCH=main
BOOKMARKS_GIT_PUSH=1
BOOKMARKS_GIT_TIMEOUT=180
BOOKMARKS_COMMITTER_NAME=getBible Bookmarks Service
BOOKMARKS_COMMITTER_EMAIL=bookmarks@getbible.net
# Deploy key with write access to the repository (never a personal key).
GIT_SSH_COMMAND=ssh -i /etc/getbible-bookmarks/deploy_key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/getbible-bookmarks/known_hosts -o StrictHostKeyChecking=yes

# Limits. Requests per contributor: bucket capacity and refill per second.
BOOKMARKS_RATE_CAPACITY=60
BOOKMARKS_RATE_REFILL_PER_SECOND=1
# Failed authentications per client address before 429.
BOOKMARKS_AUTH_FAILURE_CAPACITY=10
BOOKMARKS_AUTH_FAILURE_REFILL_PER_SECOND=0.05
BOOKMARKS_MAX_BODY_BYTES=1048576
# Trust X-Real-IP / X-Forwarded-For from nginx (the listener is loopback only).
BOOKMARKS_TRUST_PROXY_HEADERS=1
# Browser origins allowed to call the management API (comma separated). Empty = none.
BOOKMARKS_ALLOWED_ORIGINS=
# Seconds between automatic retries of a failed push.
BOOKMARKS_PUSH_RETRY_SECONDS=60
