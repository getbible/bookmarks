[Unit]
Description=getBible bookmarks: pull merged changes and publish the current release
Documentation=https://github.com/getbible/bookmarks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=getbible-bookmarks
Group=getbible-bookmarks
EnvironmentFile=/etc/getbible-bookmarks/env
WorkingDirectory=/srv/getbible-bookmarks/repo
ExecStart=/srv/getbible-bookmarks/repo/deploy/deploy.sh
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/getbible-bookmarks/repo /srv/getbible-bookmarks/www
ReadOnlyPaths=/etc/getbible-bookmarks
